# ── API Keys ──────────────────────────────────────────
# Copy this file to .env and fill in your actual keys

# DeepSeek (cloud) — recommended for remote_client
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Qwen / DashScope (cloud)
QWEN_API_KEY=sk-your-qwen-key-here

# OpenAI (cloud) — if using GPT models
OPENAI_API_KEY=sk-your-openai-key-here
